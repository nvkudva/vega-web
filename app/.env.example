# Where the browser fetches embed_q8, decoder_q8, vision_q8 (.onnx + .onnx.data), engine.onnx,
# vega_web.json, preprocessor_config.json, tokenizer.json and tokenizer_config.json from.
# Leave unset to serve them from this site's own /models directory.
VITE_MODELS_BASE=https://huggingface.co/<you>/vega-onnx-q8/resolve/main/v2
