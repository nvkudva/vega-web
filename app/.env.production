# Deploys fetch weights from the Hugging Face CDN, not from the site itself, so
# dist stays small. The version segment (v2) is part of the cache key: re-quantizing means
# uploading to a new version rather than overwriting, or returning visitors keep stale weights.
VITE_MODELS_BASE=https://huggingface.co/nvkudva/vega-onnx-q8/resolve/main/v2
